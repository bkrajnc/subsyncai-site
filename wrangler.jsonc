{
  "name": "subsyncai-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "SUPPORT_MAIL" }],
  "vars": { "SUPPORT_TO": "support@subsyncai.app", "MAIL_FROM": "forms@subsyncai.app" }
}
